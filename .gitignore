node_modules/
.expo/
dist/
dist-export/
*.log
.DS_Store

# TypeScript build info
*.tsbuildinfo

# Generated native projects (Expo CNG/prebuild) — never committed, see ADR-0005.
# apps/mobile/.gitignore already ignores these relative to that workspace;
# listed here too for repo-root visibility.
apps/mobile/ios/
apps/mobile/android/
builds/

# E2E screenshots written by the agent-browser daemon into its cwd (never commit)
/[0-9][0-9]-*.png

# @onebeyond/license-checker drops a report file on every failing scan
license-error-*.md

__pycache__/
