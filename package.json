{
  "name": "circuit-timer",
  "private": true,
  "version": "0.0.0",
  "description": "GNSS track lap-timing monorepo (npm workspaces)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate:tmr": "node --experimental-strip-types packages/core/scripts/generate-tmr-profile.ts",
    "generate:motorpark": "node --experimental-strip-types packages/core/scripts/generate-motorpark-profile.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
