{"nodes": [{"id": "foreman_scratch_ticket_wp8_statemachine_task", "label": "WP8 Session State Machine Task", "file_type": "document", "source_file": ".foreman/scratch/ticket-wp8-statemachine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure, deterministic reducer: no Date.now, no timers, no randomness, no I/O -- all time arrives inside events so the machine is fully testable and checkpoint-serializable."}, {"id": "foreman_scratch_ticket_wp8_statemachine_reducer", "label": "SessionReducer (pure state machine)", "file_type": "concept", "source_file": ".foreman/scratch/ticket-wp8-statemachine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "foreman_scratch_ticket_wp8_statemachine_states", "label": "Session states (idle..armed..timing..sessionComplete..error)", "file_type": "concept", "source_file": ".foreman/scratch/ticket-wp8-statemachine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "foreman_scratch_ticket_wp8_statemachine_illegal_event_identity", "label": "Illegal-event identity-return rule", "file_type": "rationale", "source_file": ".foreman/scratch/ticket-wp8-statemachine.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Illegal events for a state are ignored by returning the SAME snapshot by reference rather than throwing, which keeps the reducer safe to call from any UI state and trivially testable."}], "edges": [], "hyperedges": []}