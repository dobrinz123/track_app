{"nodes": [{"id": "docs_algorithms_live_delta", "label": "Live Delta Algorithm Doc", "file_type": "document", "source_file": "docs/algorithms/live-delta.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_algorithms_live_delta_reference_lap_resampling", "label": "Reference Lap Resampling (10 m grid, monotone clamp)", "file_type": "rationale", "source_file": "docs/algorithms/live-delta.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "buildReferenceLap resamples a completed lap onto a fixed 10 m distance grid; distances are monotone-clamped per sample and elapsed times re-clamped non-decreasing across the grid (belt-and-suspenders), anchored to (0,0) and (totalLengthM, durationMs). Fails INSUFFICIENT_COVERAGE unless >=95% of grid points fall inside the telemetry span."}, {"id": "docs_algorithms_live_delta_pb_replacement_rules", "label": "PB Replacement Rules", "file_type": "rationale", "source_file": "docs/algorithms/live-delta.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every rule must hold: same circuit/layout/layoutVersion identity, lap valid, quality floor good/degraded, not a pit lap, sectors complete and ordered, strictly faster, full telemetry with a full reference grid, provenance present, duration sanity within 1 ms. Replacement is atomic write-new-then-swap, evaluated immediately after every completed valid lap, never deferred to session end."}, {"id": "docs_algorithms_live_delta_ema_smoothing", "label": "EMA Delta Display Smoothing (alpha 0.3)", "file_type": "rationale", "source_file": "docs/algorithms/live-delta.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "displayedDeltaMs is an exponential moving average of rawDeltaMs (default alpha 0.3); on progress regression the EMA is held unchanged rather than updated; setReference/reset clear all state so every new lap and PB replacement starts the EMA fresh. Neutral display forced on staleness (>5 s gap), low confidence (<0.4), or unreliable quality."}], "edges": [{"source": "docs_algorithms_live_delta", "target": "docs_architecture_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/live-delta.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_live_delta", "target": "docs_persistence_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/live-delta.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_live_delta", "target": "docs_algorithms_live_delta_reference_lap_resampling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/live-delta.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_live_delta", "target": "docs_algorithms_live_delta_pb_replacement_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/live-delta.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_live_delta", "target": "docs_algorithms_live_delta_ema_smoothing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/live-delta.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_live_delta", "target": "docs_architecture_contracts_delta_sign_convention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/live-delta.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_live_delta_pb_replacement_rules", "target": "docs_architecture_current_state_sessioncontroller", "relation": "conceptually_related_to", "confidence": "EXTRAC