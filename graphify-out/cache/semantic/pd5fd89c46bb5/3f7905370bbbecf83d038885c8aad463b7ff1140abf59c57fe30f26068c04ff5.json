{"nodes": [{"id": "apps_mobile_assets_android_icon_background_adaptive_icon_background_layer", "label": "Android Adaptive Icon Background Layer", "file_type": "image", "source_file": "apps/mobile/assets/android-icon-background.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_mobile_assets_android_icon_background_blueprint_construction_grid", "label": "Blueprint Construction-Grid Motif", "file_type": "concept", "source_file": "apps/mobile/assets/android-icon-background.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The background layer is drawn as a technical-drawing construction grid: two concentric circles around a small center point, a dashed vertical centerline, a solid horizontal baseline, and dashed diagonal guides forming a triangle apex at the top of the outer circle, all in light blue line-work on a pale blue field. The motif communicates precision/measurement \u2014 fitting for a lap-timing app \u2014 and its near-monochrome low-contrast styling keeps the layer safe under Android adaptive-icon masking and parallax cropping, where outer regions may be cut off."}, {"id": "apps_mobile_assets_android_icon_background_trace_brand_identity", "label": "TRACE Brand Identity (precision lap timing)", "file_type": "concept", "source_file": "apps/mobile/assets/android-icon-background.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "apps_mobile_assets_android_icon_background_adaptive_icon_background_layer", "target": "apps_mobile_assets_android_icon_background_blueprint_construction_grid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/mobile/assets/android-icon-background.png", "source_location": null, "weight": 1.0}, {"source": "apps_mobile_assets_android_icon_background_blueprint_constru