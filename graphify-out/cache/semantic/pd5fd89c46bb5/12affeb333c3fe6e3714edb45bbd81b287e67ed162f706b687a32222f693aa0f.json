{"nodes": [{"id": "apps_mobile_assets_trace_logo_mark_logo", "label": "TRACE Logo Mark (transparent PNG)", "file_type": "image", "source_file": "apps/mobile/assets/trace_logo_mark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_mobile_assets_trace_logo_mark_metallic_t_letterform", "label": "Metallic T Letterform", "file_type": "concept", "source_file": "apps/mobile/assets/trace_logo_mark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark gunmetal, beveled/chamfered 3D letter T with light edge highlights; anchors the mark as the initial of the app name TRACE and reads cleanly on transparent/dark backgrounds."}, {"id": "apps_mobile_assets_trace_logo_mark_amber_racing_line", "label": "Amber Neon Racing-Line Trace", "file_type": "concept", "source_file": "apps/mobile/assets/trace_logo_mark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Glowing amber/yellow neon tube with outer glow that runs up the T's stem, loops through a hairpin curve over the crossbar, and doubles back down \u2014 a visual pun: the 'trace' is a driver's racing line through a hairpin corner, encoding the lap-timing purpose of the app directly in the mark."}, {"id": "apps_mobile_assets_trace_logo_mark_trace_brand", "label": "TRACE Lap-Timing App Brand Identity", "file_type": "concept", "source_file": "apps/mobile/assets/trace_logo_mark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand identity for the TRACE lap-timing app: dark metallic base plus amber accent, motorsport night-race aesthetic; rasterized from trace_logo_mark.svg for use as the mobile app's logo asset."}], "edges": [{"source": "apps_mobile_assets_trace_logo_mark_logo", "target": "apps_mobile_assets_trace_logo_mark_trace_brand", "relati