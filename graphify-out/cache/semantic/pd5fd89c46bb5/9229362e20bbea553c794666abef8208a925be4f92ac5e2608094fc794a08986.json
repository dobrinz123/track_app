{"nodes": [{"id": "apps_mobile_assets_android_icon_foreground_android_icon_foreground", "label": "Android Adaptive Icon Foreground (TRACE)", "file_type": "image", "source_file": "apps/mobile/assets/android-icon-foreground.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_mobile_assets_android_icon_foreground_chevron_mark", "label": "Blue Chevron Apex Mark", "file_type": "concept", "source_file": "apps/mobile/assets/android-icon-foreground.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upward-pointing chevron (caret/apex shape) reads as the letter 'A' apex and as a track-apex/summit motif appropriate for a lap-timing app; centered on a plain white field with generous margins so the Android adaptive-icon mask can crop safely without clipping the mark."}, {"id": "apps_mobile_assets_android_icon_foreground_blue_gradient_style", "label": "Glossy Blue Gradient Treatment", "file_type": "concept", "source_file": "apps/mobile/assets/android-icon-foreground.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saturated blue at the top fading to a pale ice-blue toward the lower leg tips, with soft inner glow and rounded stroke ends \u2014 gives the flat glyph depth and a modern iOS/Android 'liquid glass' feel without extra shapes."}, {"id": "apps_mobile_assets_android_icon_foreground_trace_brand", "label": "TRACE Brand Identity", "file_type": "concept", "source_file": "apps/mobile/assets/android-icon-foreground.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "apps_mobile_assets_android_icon_foreground_android_icon_foreground", "target": "apps_mobile_assets_android_icon_foreground_chevron_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_