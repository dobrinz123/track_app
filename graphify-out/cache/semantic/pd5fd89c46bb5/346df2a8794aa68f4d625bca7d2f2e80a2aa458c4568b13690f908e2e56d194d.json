{"nodes": [{"id": "docs_algorithms_calibration", "label": "Calibration (Learn Lap) Algorithm Doc", "file_type": "document", "source_file": "docs/algorithms/calibration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_algorithms_calibration_learn_lap", "label": "Learn Lap Calibration", "file_type": "rationale", "source_file": "docs/algorithms/calibration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers one question only: is this session's GNSS trace trustworthy against the already-fixed profile geometry? Never creates or edits circuit geometry. Live auto-finish threshold (98% coverage) is deliberately above the 95% acceptance bar so direction-vote confidence, sample rate, and rejected-sample fraction firm up before the verdict; no stall timeout exists by design."}, {"id": "docs_algorithms_calibration_bounded_bias_estimation", "label": "Bounded Bias Estimation", "file_type": "rationale", "source_file": "docs/algorithms/calibration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-pass trimmed least-squares (trim outer 10% residuals) against lateral residuals and centerline normals. Candidate applied only if 1.5-8 m magnitude AND p95 lateral spread improves to <=80% of before \u2014 smaller is noise, larger is an untrustworthy solve; the correction must measurably tighten spread, not just move it."}, {"id": "docs_algorithms_calibration_coverage_bins", "label": "Coverage Bins (25 m monotonic centerline coverage)", "file_type": "rationale", "source_file": "docs/algorithms/calibration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centerline divided into 25 m boolean bins; once covered, always covered (never regresses), with between-sample bin spanning unless the step is an implausible jump. Monotonicity is what makes the 98% auto-finish reachable exactly once."}], "edges": [{"source": "docs_algorithms_calibration", "target": "docs_adding_a_circuit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_calibration", "target": "docs_known_limitations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_calibration", "target": "docs_algorithms_calibration_learn_lap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_calibration", "target": "docs_algorithms_calibration_bounded_bias_estimation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_calibration", "target": "docs_algorithms_calibration_coverage_bins", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_calibration_learn_lap", "target": "docs_architecture_contracts_circuitprofile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_calibration_coverage_bins", "target": "docs_algorithms_calibration_learn_lap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/calibration.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithm