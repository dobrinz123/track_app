{"nodes": [{"id": "docs_algorithms_timing_and_crossings", "label": "Timing and Crossings Algorithm Doc", "file_type": "document", "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_algorithms_timing_and_crossings_directed_gate_crossing", "label": "Directed Gate Crossing Detection", "file_type": "rationale", "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Segment-segment intersection between the gate segment a->b and the motion segment prev->curr; direction is the sign of cross(gateVector, motionVector), only forward crossings count for timing; tCross is linearly interpolated between sample tMono values with IEEE-754 interior-value correction."}, {"id": "docs_algorithms_timing_and_crossings_rearm_debounce", "label": "Gate Rearm Debounce (50 m)", "file_type": "rationale", "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a counted forward crossing, further crossings of the same gate are suppressed until minRearmDistanceM (50 m) more unwrapped progress \u2014 turns five start-line jitter oscillations into exactly one counted crossing."}, {"id": "docs_algorithms_timing_and_crossings_monotonic_time_rule", "label": "Monotonic Time Rule (incl. cross-launch rule)", "file_type": "rationale", "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All durations come from monotonic performance.now()-sourced tMono, never wall clock. Binding cross-launch rule (ADR-0003 \u00a73): performance.now() origin resets per process launch, so tMono values from different launches are never comparable \u2014 recovery must never resume an in-flight lap timer, appending a zero-duration RECOVERY lap instead."}], "edges": [{"source": "docs_algorithms_timing_and_crossings", "target": "docs_architecture_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_timing_and_crossings", "target": "docs_adding_a_circuit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_timing_and_crossings", "target": "docs_persistence_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_timing_and_crossings", "target": "docs_decisions_adr_0003_ios_primary_target", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_timing_and_crossings", "target": "docs_algorithms_timing_and_crossings_directed_gate_crossing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_timing_and_crossings", "target": "docs_algorithms_timing_and_crossings_rearm_debounce", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/algorithms/timing-and-crossings.md", "source_location": null, "weight": 1.0}, {"source": "docs_algorithms_timing_and_crossings", "target": "docs_algorithms_timing_and_crossings_monotonic_time_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou