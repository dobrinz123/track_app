{"nodes": [{"id": "foreman_scratch_ticket_wp14_integration_task", "label": "WP14 Full Integration Task", "file_type": "document", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the mock session facade with the real production pipeline, wires persistence/recovery/watchdog, and proves offline standalone readiness -- this makes the app functionally complete."}, {"id": "foreman_scratch_ticket_wp14_integration_sessioncontroller", "label": "SessionController (production orchestrator)", "file_type": "concept", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "foreman_scratch_ticket_wp14_integration_watchdog", "label": "Watchdog provider-restart mechanism (ADR-0003 amendment)", "file_type": "rationale", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If no sample arrives for > watchdogTimeoutMs while active and not paused, the controller invokes a restartProvider callback and increments a diagnostic, so a stalled GNSS stream self-recovers instead of silently freezing the dashboard."}, {"id": "foreman_scratch_ticket_wp14_integration_recovery", "label": "Checkpoint recovery on relaunch (ADR-0003 recovery flow)", "file_type": "rationale", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On launch, an incomplete-session checkpoint offers recovery; restored laps are historical and the in-flight lap is marked invalid (RECOVERY) because tMono is per-launch and can never be compared across launches."}, {"id": "foreman_scratch_ticket_wp14_integration_realsessionfacade", "label": "RealSessionFacade (adapts SessionController to SessionFacade)", "file_type": "concept", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "foreman_scratch_ticket_wp14_integration_static_bundle_proof", "label": "Static-bundle offline proof (TMR profile inlined, no fetch/fs at runtime)", "file_type": "rationale", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The TMR profile must be a STATIC import so Metro inlines it into the bundle, and the app must never fetch or read from disk at runtime, so the app works fully standalone/offline on track."}, {"id": "foreman_scratch_ticket_wp14_integration_devreplayscreen_wiring", "label": "DevReplayScreen wired to real fixtures via ReplayLocationProvider (10x)", "file_type": "concept", "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "foreman_scratch_ticket_wp14_integration_task", "target": "foreman_scratch_ticket_wp10_replay_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "weight": 1}, {"source": "foreman_scratch_ticket_wp14_integration_task", "target": "foreman_scratch_ticket_wp11a_persistence_core_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".foreman/scratch/ticket-wp14-integration.md", "source_location": null, "weight": 1}, {"source": "foreman_scratch_ticket_wp14_integration_task", "target": "foreman_scratch_ticket_wp11b_sqlite_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".foreman/scratch/ticket-wp14