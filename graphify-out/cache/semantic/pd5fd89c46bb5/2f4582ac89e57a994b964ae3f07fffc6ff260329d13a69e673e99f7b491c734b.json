{"nodes": [{"id": "docs_voice_pack_voice_pack", "label": "Voice Pack (WP-C6) documentation", "file_type": "document", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_voice_pack_gt_minimal_vocabulary", "label": "GT-Minimal Vocabulary (3 fixed callouts)", "file_type": "rationale", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target users are beginners: a long descriptive sentence is unprocessable at speed, so the voice is Gran Turismo-style \u2014 exactly three fixed, corner- and unit-independent imperatives (Brake hard./Brake./Lift.) mapped from BRAKE severity; CORNER_AHEAD never speaks (visual strip only); units no longer affect voice since nothing numeric is spoken."}, {"id": "docs_voice_pack_generate_voice_pack_script", "label": "generate-voice-pack.mjs (generation script)", "file_type": "concept", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent via per-phrase content hashes in manifest.json (unchanged clips skipped, never re-billed); key read only from ELEVENLABS_API_KEY env, never a repo file, never logged; total generation cost is 22 characters."}, {"id": "docs_voice_pack_voiceclips_gen", "label": "voiceClips.gen.ts (static require map)", "file_type": "concept", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked in empty ({}) until clips exist so the app builds before generation; always regenerated to match mp3s on disk \u2014 never hand-edited."}, {"id": "docs_voice_pack_voiceutteranceidforcue", "label": "voiceUtteranceIdForCue (severity\u2192utterance mapping)", "file_type": "concept", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_voice_pack_phraseforcue", "label": "phraseForCue (legacy descriptive phrasing)", "file_type": "concept", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as a pure, independently-tested utility (e.g. future accessibility transcript) but no longer what gets spoken."}, {"id": "docs_voice_pack_adr_0004_offline_mandate", "label": "ADR-0004 Offline Mandate", "file_type": "rationale", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A timed session must make zero network calls, so cloud TTS cannot run at session time \u2014 clips are generated once offline and bundled; the app never talks to ElevenLabs at runtime."}, {"id": "docs_voice_pack_elevenlabs_api", "label": "ElevenLabs Text-to-Speech API", "file_type": "concept", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_voice_pack_expo_speech_fallback", "label": "expo-speech Offline Fallback", "file_type": "concept", "source_file": "docs/voice-pack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_voice_pack_voice_pack", "target": "docs_voice_pack_gt_minimal_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/voice-pack.md", "source_location": null, "weight": 1.0}, {"source": "docs_voice_pack_voice_pack", "target": "docs_voice_pack_generate_voice_pack_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/voice-pack.md", "source_location": null, "weight": 1.0}, {"source": "docs_voice_pack_adr_0004_o