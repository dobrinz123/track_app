{"nodes": [{"id": "docs_persistence_model", "label": "Persistence Model (SQLite schema, checkpoints, recovery)", "file_type": "document", "source_file": "docs/persistence-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_persistence_model_checkpoint_cadence", "label": "Checkpoint Cadence (pause, lap complete, session end)", "file_type": "rationale", "source_file": "docs/persistence-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checkpoints are written at exactly three points \u2014 pause, every completed lap, and session end (a terminal checkpoint so recovery never re-offers a saved session) \u2014 not per sample; a mid-lap crash can therefore lose telemetry back to the last boundary, which the recovery flow covers with a RECOVERY placeholder lap rather than fabricating a duration."}, {"id": "docs_persistence_model_recovery_flow", "label": "Checkpoint Recovery Flow", "file_type": "rationale", "source_file": "docs/persistence-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical laps restore verbatim into a fresh pipeline; a lap open at checkpoint time becomes a synthetic zero-duration RECOVERY lap (never a fabricated real time, because tMono is incomparable across launches); the session re-enters awaitingCalibration, with start('session') as the explicit resume-without-recalibrating path that dispatches a synthetic always-accepted calibration result."}], "edges": [{"source": "docs_persistence_model", "target": "docs_architecture_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/persistence-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_persistence_model", "target": "docs_decisions_adr_0003_ios_primary_target", "relation": "references", "confiden