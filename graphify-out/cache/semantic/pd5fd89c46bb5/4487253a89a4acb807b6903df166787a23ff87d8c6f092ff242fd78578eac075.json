{"nodes": [{"id": "_foreman_scratch_free_ios_install_research_research_packet", "label": "Free iOS sideloading research packet (Aug 2026)", "file_type": "document", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_foreman_scratch_free_ios_install_research_expo_go_retirement", "label": "Expo Go SDK 57 absent from iOS App Store", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": "https://expo.dev/changelog/expo-go-and-app-store-may-2026", "captured_at": null, "author": null, "contributor": null, "rationale": "Expo is not releasing an SDK 57 Expo Go on the App Store (last approved version supports SDK 55 or earlier), which explains the user's 'version too new' error and forces the sideload path for both dev and on-track use."}, {"id": "_foreman_scratch_free_ios_install_research_unsigned_ipa_route", "label": "Unsigned IPA route (expo prebuild + xcodebuild, no signing)", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAS Build device builds require a paid Apple account, so the free path is: expo prebuild, xcodebuild archive with CODE_SIGNING_ALLOWED=NO, zip the .app as Payload -> .ipa, then sideload."}, {"id": "_foreman_scratch_free_ios_install_research_sideloadly", "label": "Sideloadly (Windows sideloading tool)", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": "https://sideloadly.io", "captured_at": null, "author": null, "contributor": null}, {"id": "_foreman_scratch_free_ios_install_research_altstore", "label": "AltStore Classic", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": "https://faq.altstore.io/altstore-classic/your-altstore", "captured_at": null, "author": null, "contributor": null}, {"id": "_foreman_scratch_free_ios_install_research_github_actions_macos", "label": "GitHub Actions free macOS runners (public repo)", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public repos get unlimited free macOS minutes; private repos get 2000 shared minutes at $0.062/min for macOS (~2-3 iOS builds/month) \u2014 hence the recommendation to keep the repo public for the free build pipeline."}, {"id": "_foreman_scratch_free_ios_install_research_free_team_entitlements", "label": "Free personal-team entitlement limits", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free Apple ID signing blocks push, iCloud, App Groups, and background modes, but the app's modules (expo-location when-in-use, expo-sqlite, expo-sensors, expo-keep-awake) need none of the blocked entitlements, so free sideloading is viable."}, {"id": "_foreman_scratch_free_ios_install_research_eu_dma_sideloading", "label": "EU DMA sideloading allowance (Romania)", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_foreman_scratch_free_ios_install_research_seven_day_resign_cycle", "label": "7-day signature / re-sign cycle (free Apple ID)", "file_type": "concept", "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free Apple ID signatures last 7 days with a 3-app device limit; re-sideloading the same bundle id with the same Apple ID preserves app data, making a weekly ~2-minute re-sign routine the maintenance cost of the free path."}], "edges": [{"source": "_foreman_scratch_free_ios_install_research_expo_go_retirement", "target": "_foreman_scratch_free_ios_install_research_unsigned_ipa_route", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "weight": 1.0}, {"source": "_foreman_scratch_free_ios_install_research_unsigned_ipa_route", "target": "_foreman_scratch_free_ios_install_research_github_actions_macos", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "weight": 1.0}, {"source": "_foreman_scratch_free_ios_install_research_unsigned_ipa_route", "target": "_foreman_scratch_free_ios_install_research_free_team_entitlements", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "weight": 1.0}, {"source": "_foreman_scratch_free_ios_install_research_sideloadly", "target": "_foreman_scratch_free_ios_install_research_seven_day_resign_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "weight": 1.0}, {"source": "_foreman_scratch_free_ios_install_research_altstore", "target": "_foreman_scratch_free_ios_install_research_sideloadly", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".foreman/scratch/free-ios-install-research.md", "source_location": null, "weight": 1.0}, {"source": "_foreman_scratch_free_ios_install_research_eu_dma_sideloading", "target": "_foreman_scratch_free_ios_in